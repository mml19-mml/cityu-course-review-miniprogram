page {
  background: #f5f7fa;
  color: #1f2937;
}

.course-page {
  padding: 40rpx 28rpx 60rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.list-summary {
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.course-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-code {
  font-size: 26rpx;
  font-weight: 600;
  color: #047857;
}

.course-credit {
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  background: #ecfdf5;
  font-size: 24rpx;
  color: #047857;
}

.course-name {
  margin-top: 22rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: break-word;
}

.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f2f5;
}

.course-score {
  font-size: 26rpx;
  color: #9a6700;
}

.review-count {
  font-size: 24rpx;
  color: #6b7280;
}

.state-box {
  padding: 80rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.8;
  color: #6b7280;
}

.retry-button {
  width: 260rpx;
  margin-top: 30rpx;
  background: #047857;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 14rpx;
}

.retry-button::after {
  border: none;
}